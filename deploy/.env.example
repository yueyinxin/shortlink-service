# =============================================================================
# 生产环境变量模板
#
# 使用方法：
#   cp deploy/.env.example deploy/.env
#   然后用 openssl 生成密钥、填写域名，最后：
#   docker compose -f deploy/compose.prod.yaml --env-file deploy/.env up -d
#
# 【重要】deploy/.env 已被 .gitignore 排除。绝不要把它提交到版本库 ——
# 一旦密钥进入 git 历史，即使后续删除也仍然可以从历史中恢复，
# 唯一的补救办法是更换全部密钥。
# =============================================================================

# ---------------------------------------------------------------- 数据库
MYSQL_DATABASE=shortlink
MYSQL_USER=shortlink
# 用 openssl rand -base64 24 生成，不要使用有意义的单词
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=512mb

# ---------------------------------------------------------------- 应用
# 对外访问地址，必须是外部可访问的域名或 IP。
# 这个值决定返回给用户的短链长什么样，写错会导致生成的短链打不开。
SHORTLINK_BASE_URL=https://s.example.com

# JWT 签名密钥，至少 32 字节。生成方式：openssl rand -base64 48
SHORTLINK_JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES

# 短码置换密钥。决定「序列号 → 短码」的映射关系。
# 【注意】更换此密钥不会使已有短链失效（短链按短码存储与查询，从不反向解码），
# 但会改变新短码的映射。正常运行时不要随意更换。
SHORTLINK_CODE_SECRET=CHANGE_ME

# 是否信任 X-Forwarded-For 头。
# 只有在应用部署于受控反向代理之后、且代理会【覆盖】该头时才设为 true。
# 若代理是追加（Nginx 的 $proxy_add_x_forwarded_for）或直接暴露应用端口，
# 必须保持 false —— 否则任何客户端都能伪造 IP 绕过限流。
TRUST_FORWARDED_HEADERS=false

# 统计刷库开关。多实例部署时只应在一个实例上开启（除非已引入分布式锁）。
STATS_FLUSH_ENABLED=true

# ---------------------------------------------------------------- 镜像
APP_IMAGE=shortlink-service:1.0.0
