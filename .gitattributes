# =============================================================================
# 换行符与文件类型的统一处理
#
# 不配置这个文件的话，不同操作系统上的 Git 会用不同策略处理换行符：
# Windows 开发者检出时是 CRLF、提交时转回 LF，而 Linux/macOS 全程是 LF。
# 单看没问题，但当两者交替修改同一个文件时，会产生"整个文件都被标记为变更"
# 的巨大 diff —— 真正改动的那几行淹没在里面，代码评审无法进行。
#
# 规则：仓库内一律存 LF，检出时按这里声明的策略转换。
# =============================================================================

# 默认：自动识别文本文件，检出时使用 LF
* text=auto eol=lf

# ------------------------------------------------------------------ 必须 LF
# 这些是在类 Unix 环境执行的脚本。带 CRLF 会导致
# "bad interpreter: No such file or directory" 这类难以理解的错误。
/mvnw text eol=lf
/gradlew text eol=lf
*.sh text eol=lf

# ------------------------------------------------------------------ 必须 CRLF
# Windows 批处理解析器对 LF 支持不完整，用 LF 可能导致命令拼接错误
*.cmd text eol=crlf
*.bat text eol=crlf

# ------------------------------------------------------------------ 二进制
# 明确标记为二进制，避免 Git 尝试做换行符转换而损坏文件
*.jar binary
*.war binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# SQL 迁移脚本
*.sql text eol=lf
